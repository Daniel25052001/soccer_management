datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Tournament {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  status      String   @default("DRAFT") // 'DRAFT', 'IN_PROGRESS', 'FINISHED', 'CANCELLED'
  createdAt   DateTime @default(now())

  teams     Team[]
  matches   Match[]
  standings Standing[]
}

model Team {
  id            Int      @id @default(autoincrement())
  tournamentId  Int?
  name          String
  delegateName  String?
  delegatePhone String?
  createdAt     DateTime @default(now())

  tournament    Tournament?         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  players       Player[]
  homeMatches   Match[]             @relation("HomeTeam")
  awayMatches   Match[]             @relation("AwayTeam")
  rosters       MatchRoster[]
  substitutions MatchSubstitution[]
  events        MatchEvent[]
  standings     Standing[]

  @@index([tournamentId])
}

model Player {
  id            Int      @id @default(autoincrement())
  teamId        Int
  firstName     String
  lastName      String
  documentId    String   @unique
  defaultDorsal Int?
  position      String?  // 'GOALKEEPER', 'DEFENDER', 'FULLBACK', 'MIDFIELDER', 'FORWARD'
  isPaid        Boolean  @default(false)
  createdAt     DateTime @default(now())

  team      Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rosters   MatchRoster[]
  subsOut   MatchSubstitution[] @relation("PlayerOut")
  subsIn    MatchSubstitution[] @relation("PlayerIn")
  events    MatchEvent[]
  sanctions Sanction[]

  @@index([teamId])
}

model Match {
  id                Int      @id @default(autoincrement())
  tournamentId      Int
  homeTeamId        Int
  awayTeamId        Int
  matchDate         DateTime
  status            String   @default("SCHEDULED") // 'SCHEDULED', 'IN_PROGRESS', 'FINISHED', 'POSTPONED', 'CANCELLED'
  homeScore         Int      @default(0)
  awayScore         Int      @default(0)
  homeSubsUsed      Int      @default(0)
  homeWindowsUsed   Int      @default(0)
  awaySubsUsed      Int      @default(0)
  awayWindowsUsed   Int      @default(0)
  homeArbitragePaid Boolean  @default(false)
  awayArbitragePaid Boolean  @default(false)
  createdAt         DateTime @default(now())
  refereeId         Int?
  referee           Referee? @relation("MatchReferee", fields: [refereeId], references: [id], onDelete: SetNull)

  tournament    Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam      Team                @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team                @relation("AwayTeam", fields: [awayTeamId], references: [id])
  rosters       MatchRoster[]
  substitutions MatchSubstitution[]
  events        MatchEvent[]
  sanctions     Sanction[]

  @@index([tournamentId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model MatchRoster {
  id           Int     @id @default(autoincrement())
  matchId      Int
  teamId       Int
  playerId     Int
  jerseyNumber Int
  isStarter    Boolean @default(false)
  isSuspended  Boolean @default(false)

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
}

model MatchSubstitution {
  id           Int     @id @default(autoincrement())
  matchId      Int
  teamId       Int
  playerOutId  Int
  playerInId   Int
  minute       Int
  windowNumber Int
  isHalftime   Boolean @default(false)

  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team      Team   @relation(fields: [teamId], references: [id])
  playerOut Player @relation("PlayerOut", fields: [playerOutId], references: [id])
  playerIn  Player @relation("PlayerIn", fields: [playerInId], references: [id])

  @@index([matchId])
  @@index([teamId])
  @@index([playerOutId])
  @@index([playerInId])
}

model MatchEvent {
  id        Int      @id @default(autoincrement())
  matchId   Int
  teamId    Int
  playerId  Int
  type      String   // 'GOAL', 'OWN_GOAL', 'YELLOW_CARD', 'RED_CARD', 'DOUBLE_YELLOW_RED', 'ASSIST'
  minute    Int?
  createdAt DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
}

model Sanction {
  id               Int      @id @default(autoincrement())
  playerId         Int
  matchId          Int
  fineAmount       Float    @default(0.00)
  isFinePaid       Boolean  @default(false)
  matchesSuspended Int      @default(0)
  matchesServed    Int      @default(0)
  createdAt        DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([matchId])
}

model Standing {
  id             Int      @id @default(autoincrement())
  tournamentId   Int
  teamId         Int
  played         Int      @default(0)
  won            Int      @default(0)
  drawn          Int      @default(0)
  lost           Int      @default(0)
  goalsFor       Int      @default(0)
  goalsAgainst   Int      @default(0)
  goalDifference Int      @default(0)
  points         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
}

model Referee {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  status    String   @default("ACTIVE")
  matches   Match[]  @relation("MatchReferee")
  createdAt DateTime @default(now())
}