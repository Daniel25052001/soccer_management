datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TournamentStatus {
  DRAFT
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  PAUSED
  FINISHED
  POSTPONED
}

enum EventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  DOUBLE_YELLOW_RED
  ASSIST
}

model Tournament {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  status      TournamentStatus @default(DRAFT)
  createdAt   DateTime         @default(now())

  teams   Team[]
  matches Match[]
}

model Team {
  id            Int      @id @default(autoincrement())
  tournamentId  Int?
  name          String
  delegateName  String?
  delegatePhone String?
  createdAt     DateTime @default(now())

  tournament    Tournament?         @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  players       Player[]
  homeMatches   Match[]             @relation("HomeTeam")
  awayMatches   Match[]             @relation("AwayTeam")
  rosters       MatchRoster[]
  substitutions MatchSubstitution[]
  events        MatchEvent[]

  @@index([tournamentId])
}

model Player {
  id            Int      @id @default(autoincrement())
  teamId        Int
  firstName     String
  lastName      String
  documentId    String   @unique
  defaultDorsal Int?
  createdAt     DateTime @default(now())

  team        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rosters     MatchRoster[]
  subsOut     MatchSubstitution[] @relation("PlayerOut")
  subsIn      MatchSubstitution[] @relation("PlayerIn")
  events      MatchEvent[]
  sanctions   Sanction[]

  @@index([teamId])
}

model Match {
  id                Int         @id @default(autoincrement())
  tournamentId      Int
  homeTeamId        Int
  awayTeamId        Int
  matchDate         DateTime
  status            MatchStatus @default(SCHEDULED)
  homeScore         Int         @default(0)
  awayScore         Int         @default(0)
  homeSubsUsed      Int         @default(0)
  homeWindowsUsed   Int         @default(0)
  awaySubsUsed      Int         @default(0)
  awayWindowsUsed   Int         @default(0)
  homeArbitragePaid Boolean     @default(false)
  awayArbitragePaid Boolean     @default(false)
  createdAt         DateTime    @default(now())

  tournament    Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam      Team                @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team                @relation("AwayTeam", fields: [awayTeamId], references: [id])
  rosters       MatchRoster[]
  substitutions MatchSubstitution[]
  events        MatchEvent[]
  sanctions     Sanction[]

  @@index([tournamentId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model MatchRoster {
  id           Int     @id @default(autoincrement())
  matchId      Int
  teamId       Int
  playerId     Int
  jerseyNumber Int
  isStarter    Boolean @default(false)
  isSuspended  Boolean @default(false)

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
}

model MatchSubstitution {
  id           Int     @id @default(autoincrement())
  matchId      Int
  teamId       Int
  playerOutId  Int
  playerInId   Int
  minute       Int
  windowNumber Int
  isHalftime   Boolean @default(false)

  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team      Team   @relation(fields: [teamId], references: [id])
  playerOut Player @relation("PlayerOut", fields: [playerOutId], references: [id])
  playerIn  Player @relation("PlayerIn", fields: [playerInId], references: [id])

  @@index([matchId])
  @@index([teamId])
  @@index([playerOutId])
  @@index([playerInId])
}

model MatchEvent {
  id        Int       @id @default(autoincrement())
  matchId   Int
  teamId    Int
  playerId  Int
  eventType EventType
  minute    Int
  createdAt DateTime  @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
}

model Sanction {
  id               Int      @id @default(autoincrement())
  playerId         Int
  matchId          Int
  fineAmount       Decimal  @default(0.00) @db.Decimal(10, 2)
  isFinePaid       Boolean  @default(false)
  matchesSuspended Int      @default(0)
  matchesServed    Int      @default(0)
  createdAt        DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])
  match  Match  @relation(fields: [matchId], references: [id])

  @@index([playerId])
  @@index([matchId])
}