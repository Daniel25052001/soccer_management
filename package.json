{
    "name": "goladmin-desktop",
    "version": "1.0.0",
    "description": "Sistema de gestión de torneos deportivos GolAdmin PWA",
    "author": "Daniel Stiven Galvis Montoya",
    "main": "electron/main.js",
    "scripts": {
        "build:backend": "cd backend && npm run build",
        "build:frontend": "cd frontend && npm run build",
        "build:all": "npm run build:backend && npm run build:frontend",
        "package": "npm run build:all && electron-builder --win --x64"
    },
    "build": {
        "appId": "com.goladmin.pwa",
        "productName": "GolAdmin PWA",
        "asar": false,
        "directories": {
            "output": "C:/goladmin-release"
        },
        "win": {
            "target": [
                "nsis"
            ]
        },
        "files": [
            "electron/**/*",
            "frontend/dist/**/*",
            "backend/dist/**/*",
            "backend/node_modules/**/*",
            "!backend/node_modules/**/*.{md,ts,map}",
            "!backend/node_modules/**/{test,__tests__,tests,docs,example,examples}/**",
            "backend/prisma/**/*",
            "backend/dev.db",
            "package.json"
        ]
    },
    "devDependencies": {
        "electron": "^45.3.1",
        "electron-builder": "^26.18.0"
    }
}